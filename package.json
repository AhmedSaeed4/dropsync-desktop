{
  "name": "dropsync-desktop",
  "version": "1.0.5",
  "description": "DropSync Desktop — offline encrypted vault companion for .dropsync backups",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "DropSync",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "make-test-archives": "node scripts/make-test-archives.ts",
    "icons": "node scripts/make-icons.ts",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@zip.js/zip.js": "^2.8.36"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/raleway": "^5.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^12.40.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
